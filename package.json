{
  "name": "dair",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:deadcode": "NODE_ENV=deadcode knip-bun",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --type-aware --type-check",
    "check:types": "turbo run check:types",
    "compose": "bun run scripts/compose.ts",
    "compose:down": "bun run scripts/compose.ts down",
    "compose:up": "bun run scripts/compose.ts up --wait",
    "dev": "turbo run dev studio",
    "lint": "oxfmt && syncpack format && syncpack fix && oxlint --type-aware --type-check --fix --fix-suggestions",
    "prepare": "husky && effect-language-service patch",
    "server:build": "turbo run build --filter=@dair/api",
    "server:start": "turbo run start --filter=@dair/api",
    "test": "turbo run test",
    "workers:dev": "turbo run dev --filter=@dair/workers",
    "workers:start": "turbo run start --filter=@dair/workers"
  },
  "devDependencies": {
    "@effect/cli": "^0.73.0",
    "@effect/language-service": "^0.72.0",
    "@effect/platform-bun": "^0.87.0",
    "@types/bun": "1.3.6",
    "@typescript/native-preview": "^7.0.0-dev.20260120.1",
    "effect": "^3.19.14",
    "effect-solutions": "^0.4.13",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "oxlint-tsgolint": "^0.11.1",
    "syncpack": "^14.0.0-alpha.37",
    "turbo": "^2.7.5",
    "typescript": "^5"
  },
  "lint-staged": {
    "*": "oxlint --type-aware --fix --fix-suggestions"
  },
  "packageManager": "bun@1.3.5"
}
