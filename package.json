{
  "name": "dair",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:deadcode": "NODE_ENV=deadcode knip",
    "check:fix": "vp check --fix",
    "compose": "vp exec tsx scripts/compose.ts",
    "compose:down": "vp exec tsx scripts/compose.ts down",
    "prepare": "vp config && effect-language-service patch",
    "server:build": "vp run -F @dair/api build",
    "server:start": "vp run -F @dair/api start",
    "setup": "vp exec tsx scripts/setup/setup.mts",
    "workers:dev": "vp run -F @dair/workers dev",
    "workers:start": "vp run -F @dair/workers start"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "effect-solutions": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "syncpack": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "lint-staged": {
    "*": "vp check --fix"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.4.0"
}
