{
  "name": "dair",
  "version": "0.0.0",
  "devDependencies": {
    "@effect/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "effect-solutions": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "syncpack": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*": "oxlint --type-aware --fix --fix-suggestions"
  },
  "packageManager": "pnpm@10.33.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check:deadcode": "NODE_ENV=deadcode knip",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint --type-aware --type-check",
    "check:types": "turbo run check:types",
    "compose": "vp exec tsx scripts/compose.ts",
    "compose:down": "vp exec tsx scripts/compose.ts down",
    "compose:up": "vp exec tsx scripts/compose.ts up --wait",
    "dev": "turbo run dev studio",
    "lint": "oxfmt && syncpack format && syncpack fix && oxlint --type-aware --type-check --fix --fix-suggestions",
    "prepare": "vp config && effect-language-service patch",
    "server:build": "turbo run build --filter=@dair/api",
    "server:start": "turbo run start --filter=@dair/api",
    "setup": "vp exec tsx scripts/setup/setup.mts",
    "test": "turbo run test",
    "workers:dev": "turbo run dev --filter=@dair/workers",
    "workers:start": "turbo run start --filter=@dair/workers"
  },
  "type": "module"
}
