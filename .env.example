# PostgreSQL (compose.dev.yml)
POSTGRES_PORT=5432
POSTGRES_USER=dair
POSTGRES_PASSWORD=dair
POSTGRES_DB=dair
DATABASE_URL=postgresql://dair:dair@localhost:5432/dair

# Redis (compose.dev.yml)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
API_URL=http://localhost:3000
BRAWLHALLA_API_KEY=
# Dev only — ignored when NODE_ENV is not development (see apps/api dev/start scripts)
# BRAWLHALLA_API_MOCK=false
OAUTH_SECRET=
WORKER_API_KEY=dev-worker-key

# Client (port from APP_PORT via apps/client/vite.config.ts; setup syncs URLs from APP_PORT)
APP_PORT=3001
DEFAULT_CLIENT_URL=http://localhost:3001
# Set by vp run setup from API_PORT / APP_PORT:
# VITE_API_URL=http://localhost:3000
# VITE_CLIENT_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
VITE_SOCIAL_DISCORD_URL=https://discord.com/invite/eD248ez
VITE_SOCIAL_GITHUB_URL=https://github.com/djobbo/kubi
VITE_SOCIAL_TWITTER_URL=https://x.com/Corehalla
VITE_SOCIAL_KOFI_URL=https://ko-fi.com/corehalla
VITE_BRAWLHALLA_WIKI_URL=https://brawlhalla.wiki.gg
VITE_GOOGLE_ANALYTICS_TRACKING_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADSENSE_ID=0000000000000000

# Optional observability
# OTLP_ENDPOINT=http://localhost:4318
# SERVICE_NAME=api
# SERVICE_VERSION=0.0.0

# Phase 3 data migration only (vp run setup --with-supabase)
# MIGRATION_SUPABASE_URL=
# MIGRATION_SUPABASE_SERVICE_KEY=
# MIGRATION_DATABASE_URL=postgresql://dair:dair@localhost:5432/dair
