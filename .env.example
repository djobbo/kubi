# PostgreSQL (compose.dev.yml)
POSTGRES_PORT=5432
POSTGRES_USER=dair
POSTGRES_PASSWORD=dair
POSTGRES_DB=dair
DATABASE_URL=postgresql://dair:dair@localhost:5432/dair

# Redis (compose.dev.yml)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
API_URL=http://localhost:3000
BRAWLHALLA_API_KEY=
OAUTH_SECRET=

# Client
APP_PORT=3001
DEFAULT_CLIENT_URL=http://localhost:3001
VITE_API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001

# Optional observability
# OTLP_ENDPOINT=http://localhost:4318
# SERVICE_NAME=api
# SERVICE_VERSION=0.0.0

# Phase 3 data migration only (vp run setup --with-supabase)
# MIGRATION_SUPABASE_URL=
# MIGRATION_SUPABASE_SERVICE_KEY=
# MIGRATION_DATABASE_URL=postgresql://dair:dair@localhost:5432/dair
