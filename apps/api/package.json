{
  "name": "@dair/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "check:types": "tsgo --noEmit",
    "db:migrate": "drizzle-kit generate && drizzle-kit migrate",
    "dev": "export NODE_ENV=development && drizzle-kit generate && drizzle-kit push && tsx watch ./src/index.ts",
    "prepare": "effect-language-service patch",
    "start": "export NODE_ENV=production && pnpm run db:migrate && tsx ./src/index.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dair/api-contract": "workspace:*",
    "@dair/brawlhalla-api": "workspace:*",
    "@dair/brawlhalla-gql-api": "workspace:*",
    "@dair/brawlhalla-servers": "workspace:*",
    "@dair/brawltools-api": "workspace:*",
    "@dair/common": "workspace:*",
    "@dair/db": "workspace:*",
    "@dair/observability": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@libsql/client": "catalog:",
    "arctic": "catalog:",
    "cheerio": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "ioredis": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
